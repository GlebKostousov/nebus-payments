# Только локальная демонстрация. Перед внешним развёртыванием замените оба ключа.
API_KEY=local-demo-api-key-change-before-deploy-123456
WEBHOOK_SIGNING_SECRET=local-demo-webhook-key-change-before-deploy-123456
# Логин базы. В контейнерах адрес собирается из этих значений.
# Символы @ : / # $ в пароле сломают DATABASE_URL. Тот же пароль нужен в строке ниже: ей пользуется запуск с хоста.
# Уже созданный том пароль из .env не подхватывает. Новый пароль начинает работать после docker compose down -v.
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@127.0.0.1:5432/payments
# Логин панели http://127.0.0.1:15672 и брокера. В контейнерах URL собирается из этих двух значений.
# Те же символы в пароле сломают адрес AMQP. Тот же пароль нужен и в RABBITMQ_URL ниже.
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_URL=amqp://payments:payments@127.0.0.1:5672/
WEBHOOK_ALLOWED_ORIGINS=["http://webhook:8081"]
WEBHOOK_ALLOW_DEVELOPMENT=true
JSON_LOGS=true
CONSUMER_PREFETCH=10
OUTBOX_POLL_SECONDS=0.25
